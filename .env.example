APP_NAME="Sistem Operasional Yayasan YPIK PAM Jaya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
SERVER_PORT=8010
APP_TIMEZONE=Asia/Jakarta
ASSET_PUBLIC_URL=https://soy.ypikpamjaya.com
ASSET_LEGACY_HOSTS=ypik.pradita.website

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soy_ypik
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120



MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAINTENANCE_NOTIFICATION_EMAIL=Ridodwikurniawan@gmail.com

BLAST_EMAIL_MODE=queue
BLAST_WHATSAPP_MODE=queue
BLAST_EMAIL_ACCOUNTS_ENABLED=false
SYSTEM_ACCESS_AUDIT_ENABLED=true
IP_GEOLOCATION_ENDPOINT=
AI_FEATURE_BUILDER_ENDPOINT=
AI_FEATURE_BUILDER_TOKEN=
AI_FEATURE_EXECUTOR_ENDPOINT=
AI_FEATURE_EXECUTOR_TOKEN=
